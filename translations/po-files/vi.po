msgid ""
"\\n %b is offline, please check your internet connection and try again\\n\\n"
msgstr ""
"\\n %b đang ngoại tuyến, vui lòng kiểm tra kết nối internet của bạn và thử "
"lại\\n\\n"

#: APP-MANAGER:625
