#!/bin/sh

# AM INSTALL SCRIPT VERSION 3.6
set -u
APP=appimagetool
SITE1="AppImage/appimagetool" SITE2="ivan-hc/appimagetool" SITE3="pkgforge-dev/appimagetool-uruntime"
#VARIANT1="short label like: JuNest, Anylinux, " VARIANT2="Legacy/GTK3, Enhanced, etc."
# NOTE: this should be commented like this ^

# CREATE DIRECTORIES AND ADD REMOVER
[ -n "$APP" ] && mkdir -p "/opt/$APP/tmp" "/opt/$APP/icons" && cd "/opt/$APP/tmp" || exit 1
printf "#!/bin/sh\nset -e\nrm -f /usr/local/bin/$APP\nrm -R -f /opt/$APP" > ../remove
printf '\n%s' "rm -f /usr/local/share/applications/$APP-AM.desktop" >> ../remove
chmod a+x ../remove || exit 1

# DOWNLOAD AND PREPARE THE APP, $version is also used for updates
read -r -p "
 Choose which version of $APP AppImage to use:

 1. Official release

    Source: https://github.com/$SITE1

 2. Fork maintained by ivan-hc, to avoid breakages originating from upstream

    Source: https://github.com/$SITE2

 Which version you choose (type a number and press ENTER)?" response
RELEASE=""
if echo "$response" | grep -q "^1"; then
	RELEASE="$SITE1"
elif echo "$response" | grep -q "^2"; then
	RELEASE="$SITE2"
fi
[ -z "$RELEASE" ] && exit 0

version=$(curl -Ls https://api.github.com/repos/"$RELEASE"/releases | sed 's/[()",{} ]/\n/g' | grep -io 'https.*i686.*mage$' | head -1)
if [ -z "$version" ]; then
	printf "\n 💀 ERROR: it seems that upstream removed %b, please retry\n" "$RELEASE" && exit 1
else
	wget "$version" || exit 1
fi
cd ..
mv ./tmp/*mage ./"$APP"
# Keep this space in sync with other installation scripts
rm -R -f ./tmp || exit 1
echo "$version" > ./version
chmod a+x ./"$APP" || exit 1

# LINK TO PATH
ln -s "/opt/$APP/$APP" "/usr/local/bin/$APP"

# SCRIPT TO UPDATE THE PROGRAM
cat >> ./AM-updater << 'EOF'
#!/bin/sh
set -u
APP=appimagetool
SITE="REPLACETHIS"
version0=$(cat "/opt/$APP/version")
version=$(curl -Ls https://api.github.com/repos/REPLACETHIS/releases | sed 's/[()",{} ]/\n/g' | grep -io 'https.*i686.*mage$' | head -1)
[ -n "$version" ] || { echo "Error getting link"; exit 1; }
if command -v appimageupdatetool >/dev/null 2>&1; then
	cd "/opt/$APP" || exit 1
	appimageupdatetool -Or ./"$APP" && chmod a+x ./"$APP" && echo "$version" > ./version && exit 0
fi
if [ "$version" != "$version0" ]; then
	mkdir "/opt/$APP/tmp" && cd "/opt/$APP/tmp" || exit 1
	notify-send "A new version of $APP is available, please wait"
	wget "$version" || exit 1
	# Use tar fx ./*tar* here for example in this line in case a compressed file is downloaded.
	cd ..
	mv --backup=t ./tmp/*mage ./"$APP"
	chmod a+x ./"$APP" || exit 1
	echo "$version" > ./version
	rm -R -f ./*zs-old ./*.part ./tmp ./*~
	notify-send "$APP is updated!"
else
	echo "Update not needed!"
fi
EOF
chmod a+x ./AM-updater || exit 1
sed -i "s#REPLACETHIS#$RELEASE#g" /opt/"$APP"/AM-updater
