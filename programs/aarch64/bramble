#!/bin/sh

# AM INSTALL SCRIPT VERSION 3.6
# Bramble Desktop AppImage, installed in AppMan's applications directory.
set -eu
APP=bramble
SITE="bramble-sh/bramble"
MANIFEST="https://bramble.sh/desktop/latest.json"
APPDIR="/opt/$APP"
PLATFORM="linux-aarch64"
ASSET_ARCH="aarch64"
for tool in curl jq minisign base64; do
	command -v "$tool" >/dev/null 2>&1 || { echo "Missing required command: $tool" >&2; exit 1; }
done
mkdir -p "$APPDIR/tmp" "$APPDIR/icons"
work="$APPDIR/tmp/install-$$"
mkdir -m 700 "$work"
installed=0
[ -e "$APPDIR/$APP" ] && installed=1
cleanup() { status=$?; rm -rf "$work"; if [ "$status" -ne 0 ] && [ "$installed" -eq 0 ]; then rm -rf "$APPDIR"; fi; exit "$status"; }
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
cd "$work"
# Save one manifest per run so version and asset URL come from the same release.
curl --fail --silent --show-error --location "$MANIFEST" -o manifest.json
version=$(jq -er '.version' manifest.json)
case "$version" in ''|*[!0-9A-Za-z.+-]*) echo "Invalid version in Bramble update manifest" >&2; exit 1 ;; esac
appimage_url=$(jq -er --arg platform "$PLATFORM" '.platforms[$platform].url' manifest.json)
expected_url="https://github.com/$SITE/releases/download/${version}-desktop/Bramble_${version}_${ASSET_ARCH}.AppImage"
[ "$appimage_url" = "$expected_url" ] || { echo "Unexpected AppImage URL in Bramble update manifest" >&2; exit 1; }
cat > updater.pub <<'KEY'
untrusted comment: minisign public key: 67F935EFCFD28F69
RWRpj9LP7zX5Z/tmH3zxEGUiP+oLc0+1Nbx7l2rY2BzyzFAMxdQ59Sit
KEY
curl --fail --silent --show-error --location "$appimage_url" -o "$APP"
curl --fail --silent --show-error --location "${appimage_url}.sig" -o "$APP.sig"
base64 -d "$APP.sig" > "$APP.minisig"
minisign -V -m "$APP" -x "$APP.minisig" -p updater.pub
chmod a+x "$APP"
mv "$APP" "$APPDIR/$APP.new"
mv -f "$APPDIR/$APP.new" "$APPDIR/$APP"
printf '%s\n' "$version" > "$APPDIR/version.new"
mv -f "$APPDIR/version.new" "$APPDIR/version"
ln -sfn "$APPDIR/$APP" "/usr/local/bin/$APP"
cat > "$APPDIR/remove" <<EOF
#!/bin/sh
set -eu
rm -f "/usr/local/bin/$APP" "/usr/local/share/applications/$APP-AM.desktop"
rm -rf "$APPDIR"
EOF
chmod a+x "$APPDIR/remove"
cat > "$APPDIR/AM-updater" <<'EOF'
#!/bin/sh
set -eu
APP=bramble
SITE="bramble-sh/bramble"
MANIFEST="https://bramble.sh/desktop/latest.json"
APPDIR="/opt/$APP"
PLATFORM="linux-aarch64"
ASSET_ARCH="aarch64"
for tool in curl jq minisign base64; do command -v "$tool" >/dev/null 2>&1 || { echo "Missing required command: $tool" >&2; exit 1; }; done
stage="$APPDIR/.update-$$"
mkdir -m 700 "$stage"
cleanup() { status=$?; rm -rf "$stage"; exit "$status"; }
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
curl --fail --silent --show-error --location "$MANIFEST" -o "$stage/manifest.json"
version=$(jq -er '.version' "$stage/manifest.json")
case "$version" in ''|*[!0-9A-Za-z.+-]*) echo "Invalid version in Bramble update manifest" >&2; exit 1 ;; esac
installed=$(cat "$APPDIR/version" 2>/dev/null || :)
if [ -n "$installed" ] && ! printf '%s\n%s\n' "$installed" "$version" | grep -q '^https://'; then
	newest=$(printf '%s\n%s\n' "$installed" "$version" | sort -V | tail -n 1)
	if [ "$newest" = "$installed" ]; then echo "Bramble is already current or newer ($installed)"; exit 0; fi
fi
appimage_url=$(jq -er --arg platform "$PLATFORM" '.platforms[$platform].url' "$stage/manifest.json")
expected_url="https://github.com/$SITE/releases/download/${version}-desktop/Bramble_${version}_${ASSET_ARCH}.AppImage"
[ "$appimage_url" = "$expected_url" ] || { echo "Unexpected AppImage URL in Bramble update manifest" >&2; exit 1; }
curl --fail --silent --show-error --location "$appimage_url" -o "$stage/$APP"
curl --fail --silent --show-error --location "${appimage_url}.sig" -o "$stage/$APP.sig"
base64 -d "$stage/$APP.sig" > "$stage/$APP.minisig"
cat > "$stage/updater.pub" <<'KEY'
untrusted comment: minisign public key: 67F935EFCFD28F69
RWRpj9LP7zX5Z/tmH3zxEGUiP+oLc0+1Nbx7l2rY2BzyzFAMxdQ59Sit
KEY
minisign -V -m "$stage/$APP" -x "$stage/$APP.minisig" -p "$stage/updater.pub"
chmod a+x "$stage/$APP"
printf '%s\n' "$version" > "$stage/version"
cp -p "$APPDIR/$APP" "$stage/$APP.old"
cp -p "$APPDIR/version" "$stage/version.old"
committing=1
rollback() {
	status=$?
	trap - EXIT HUP INT TERM
	if [ "${committing:-0}" -eq 1 ]; then
		mv -f "$stage/$APP.old" "$APPDIR/$APP" || echo "Could not restore Bramble image from $stage" >&2
		mv -f "$stage/version.old" "$APPDIR/version" || echo "Could not restore Bramble version from $stage" >&2
	fi
	rm -f "$APPDIR/$APP.new" "$APPDIR/version.new"
	rm -rf "$stage"
	exit "$status"
}
trap rollback EXIT
mv "$stage/$APP" "$APPDIR/$APP.new"
mv -f "$APPDIR/$APP.new" "$APPDIR/$APP"
mv "$stage/version" "$APPDIR/version.new"
mv -f "$APPDIR/version.new" "$APPDIR/version"
committing=0
trap cleanup EXIT
printf 'Bramble updated to %s\n' "$version"
EOF
sed -i "s/linux-aarch64/$PLATFORM/g; s/aarch64/$ASSET_ARCH/g" "$APPDIR/AM-updater"
chmod a+x "$APPDIR/AM-updater"
rm -f "$APPDIR/version.new"
# Resolve embedded symlinks before copying launch metadata. Only Exec and Icon
# are rewritten, so StartupWMClass and other desktop integration keys survive.
cd "$APPDIR"
if ./$APP --appimage-extract >/dev/null 2>&1; then
	icon=$(readlink -f squashfs-root/.DirIcon 2>/dev/null || :)
	case "$icon" in "$(pwd)/squashfs-root/"*) [ -f "$icon" ] && cp "$icon" "$APPDIR/icons/$APP" ;; esac
	desktop=
	for f in squashfs-root/*.desktop; do
		[ -f "$f" ] || continue
		resolved=$(readlink -f "$f" 2>/dev/null || :)
		case "$resolved" in "$(pwd)/squashfs-root/"*) [ -f "$resolved" ] && { desktop=$resolved; break; } ;; esac
	done
	if [ -n "$desktop" ] && [ -f "$APPDIR/icons/$APP" ]; then
		cp "$desktop" "$APP.desktop"
		sed -i "s#^Exec=.*#Exec=$APP#g; s#^Icon=.*#Icon=$APPDIR/icons/$APP#g; s# --no-sandbox##g" "$APP.desktop"
		mv "$APP.desktop" "/usr/local/share/applications/$APP-AM.desktop"
	fi
	rm -rf squashfs-root
fi
